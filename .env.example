APP_NAME=DexVault
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mail delivery.
#
# `log` writes messages to storage/logs/laravel.log instead of sending them.
# That is the right default for local work, and it is what keeps a new
# developer from sending real mail by accident, but it also means the
# verification email never arrives. To confirm an account locally, either
# register and then open the signed link out of the log:
#
#   grep -o 'http://localhost:8000/email/verify[^ ]*' storage/logs/laravel.log
#
# ...or temporarily set MAIL_MAILER=array and read the message in a test.
#
# To deliver real mail, pick one transport and fill in its credentials:
#
#   Resend (no extra Composer package needed)
#     MAIL_MAILER=resend
#     RESEND_API_KEY=re_...
#     MAIL_FROM_ADDRESS=you@your-verified-domain.com
#
#   SMTP (e.g. Postmark, Mailgun, or a Google Workspace mailbox)
#     MAIL_MAILER=smtp
#     MAIL_SCHEME=smtps
#     MAIL_HOST=smtp.your-provider.com
#     MAIL_PORT=587
#     MAIL_USERNAME=...
#     MAIL_PASSWORD=...
#
# MAIL_FROM_ADDRESS must be a real address on a domain the provider has
# verified, and it must not be left as the example.com placeholder. The
# application refuses to boot in production otherwise, because every
# authenticated route requires a verified account and a bad sender address
# would leave nobody able to register.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Card scanner. Unset, Tesseract loads its engine and English language data
# from a public CDN. Set it to a directory on this server holding
# worker.min.js (tesseract.js), the tesseract.js-core files, and
# eng.traineddata.gz (tessdata_fast) to serve them yourself instead.
# VITE_TESSERACT_ASSET_BASE=/tesseract

# TCGdex card data source.
# TCGDEX_API_URL=https://api.tcgdex.net/v2/en

# Pokémon name searched for the landing page featured cards.
# TCGDEX_FEATURED_CARD=Charizard
